# =============================================================================
# adhd-hermes .gitignore
# =============================================================================

# --- Secrets & Credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*_rsa
*_ed25519
*_ecdsa
credentials
secrets
token

# --- Hermes data (lives on the VM, not in this repo) ---
.hermes/

# --- Build outputs ---
output/
*.raw
*.qcow2

# --- Ansible ---
ansible/*.retry
ansible/playbooks/*.retry

# --- Editor & OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Python (used by Ansible/hooks) ---
__pycache__/
*.pyc
*.pyo