# adhd-hermes — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file (it's in .gitignore).

# =============================================================================
# GitHub
# =============================================================================
# Personal Access Token — for git push/pull and API access.
# Generate at: https://github.com/settings/tokens (classic)
# Scopes needed: repo, workflow, read:org
GITHUB_TOKEN=

# =============================================================================
# LLM PROVIDER
# =============================================================================
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# =============================================================================
# OPTIONAL: Messaging Platforms
# =============================================================================
# WhatsApp — leave empty to disable
WHATSAPP_ENABLED=false

# Telegram — bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Discord — bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=

# Signal — phone number linked via signal-cli
SIGNAL_ACCOUNT=

# =============================================================================
# OPTIONAL: Additional Services
# =============================================================================
# Hugging Face — https://huggingface.co/settings/tokens
HF_TOKEN=

# Browserbase — https://browserbase.com (for browser automation)
BROWSERBASE_API_KEY=
