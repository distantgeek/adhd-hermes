[Unit]
Description=ADHD-Hermes Gateway (Messaging + Cron)
# No network-online.target dependency — Network=host with Restart=on-failure
# handles transient network gaps at boot without blocking startup.

[Container]
Image=docker.io/nousresearch/hermes-agent:latest
ContainerName=adhd-hermes-gateway
Network=host
# NOTE: On bootc systems, use /var/home/<user> not /home/<user>.
# The %h specifier resolves to /home/<user> which is wrong on bootc.
# HERMES_UID/HERMES_GID must be numeric — %u/%g resolve to username strings.
Volume=/var/home/kevbot/.hermes:/opt/data:z
Environment=HERMES_UID=1000
Environment=HERMES_GID=1000
# Override entrypoint to run gateway directly. The image's default entrypoint
# (tini → entrypoint.sh) drops to interactive mode and exits on no-TTY.
Entrypoint=/opt/hermes/.venv/bin/hermes
Exec=gateway run --accept-hooks --replace -v
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target