[Unit]
Description=OpenClaw AI Gateway (ADHD-Claw)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/openclaw/openclaw:latest
ContainerName=openclaw
PublishPort=18789:18789
PublishPort=18793:18793
Volume=/var/lib/openclaw/config:/home/node/.openclaw:Z
Volume=/var/lib/openclaw/workspace:/home/node/workspace:Z
EnvironmentFile=/etc/openclaw/env
LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
