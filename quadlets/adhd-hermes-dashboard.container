[Unit]
Description=ADHD-Hermes Dashboard (Web UI)
After=adhd-hermes-gateway.service
Wants=adhd-hermes-gateway.service

[Container]
Image=docker.io/nousresearch/hermes-agent:latest
ContainerName=adhd-hermes-dashboard
Network=host
# NOTE: On bootc systems, use /var/home/<user> not /home/<user>.
# The %h specifier resolves to /home/<user> which is wrong on bootc.
# HERMES_UID/HERMES_GID must be numeric — %u/%g resolve to username strings.
# --insecure is required for 0.0.0.0 bind; firewalld restricts to LAN only.
Volume=/var/home/kevbot/.hermes:/opt/data:z
# tmpfs for TUI build output — ephemeral, fully writable, no permission issues.
# The --tui flag compiles the TUI binary at startup; this directory is owned
# by root in the image and the build fails after privilege dropping.
Mount=type=tmpfs,target=/opt/hermes/ui-tui/packages/hermes-ink/dist,tmpfs-mode=0777
Environment=HERMES_UID=1000
Environment=HERMES_GID=1000
# Cross-container gateway health check — bypasses lock file/PID namespace isolation.
Environment=GATEWAY_HEALTH_URL=http://localhost:8642/health
# Use the image's entrypoint for UID/GID remapping and privilege dropping.
Entrypoint=/opt/hermes/docker/entrypoint.sh
Exec=dashboard --host 0.0.0.0 --no-open --insecure --tui
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target