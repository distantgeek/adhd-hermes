[Unit]
Description=ADHD-Hermes Dashboard (Web UI)
After=adhd-hermes-gateway.service
Wants=adhd-hermes-gateway.service

[Container]
Image=docker.io/nousresearch/hermes-agent:latest
ContainerName=adhd-hermes-dashboard
Network=host
Volume=/var/home/kevbot/.hermes:/opt/data:z
Environment=HERMES_UID=1000
Environment=HERMES_GID=1000
Exec=dashboard --host 0.0.0.0 --no-open --insecure
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target